# One or both authentication modes may be enabled.
URL_SECRET=replace-with-a-long-random-url-secret
AGENT_API_TOKEN=replace-with-a-separate-long-worker-to-agent-token

PORT=8788
HOST=0.0.0.0
CHROME_MCP_PACKAGE=chrome-devtools-mcp@1.6.0
CHROME_HEADLESS=false
CHROME_PROFILE_DIR=/data/chrome-profile
UPLOAD_ROOT=/data/uploads
AUDIT_DIR=/data/audit
MCP_TIMEOUT_MS=120000

# Exact domains or *.example.com wildcards. Never use * with authenticated sites.
ALLOWED_HOSTS=developer.chrome.com,localhost,127.0.0.1
# Chrome 149+ URLPattern values. Keep aligned with ALLOWED_HOSTS.
ALLOWED_URL_PATTERNS=https://developer.chrome.com/**
ALLOW_INTERACTION_TOOLS=true
ALLOW_PRIVILEGED_TOOLS=false
ALLOW_FILE_UPLOAD=false
ENABLE_WEBMCP=false

# Named Cloudflare Tunnel token for docker compose.
CLOUDFLARED_TUNNEL_TOKEN=
